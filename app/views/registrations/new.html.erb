<div class="mx-auto" style="max-width: 480px;">
<div class="card shadow-sm">
  <div class="card-body p-4">
    <h1 class="h3 mb-3">Sign up</h1>

    <% @user.errors.full_messages.each do |msg| %>
    <div class="alert alert-danger py-2"><%= msg %></div>
    <% end %>

    <%= form_with model: @user, url: registration_path do |f| %>
    <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-3">
    <%= f.label :email_address, "Email", class: "form-label" %>
    <%= f.email_field :email_address, class: "form-control" %>
    </div>
    <div class="mb-3">
    <%= f.label :password, class: "form-label" %>
    <%= f.password_field :password, class: "form-control" %>
    </div>
    <%= f.submit "Sign up", class: "btn btn-primary w-100" %>
    <% end %>

    <p class="mt-3 mb-0 text-center">Already have an account? <%= link_to "Log in", new_session_path %></p>
  </div>
</div>
</div>
