<% content_for :title, @event.title %>

<%= tag.div(notice, class: "alert alert-success") if notice %>

<%= link_to "← Back to events", events_path, class: "text-decoration-none d-inline-block mb-3" %>

<div class="card shadow-sm overflow-hidden">
  <% if @event.image_url.present? %>
    <%= image_tag @event.image_url, alt: @event.title, class: "w-100", style: "height: 360px; object-fit: cover;" %>
  <% end %>

  <div class="card-body p-4">
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="mb-2">
          <span class="badge text-bg-primary"><%= @event.category %></span>
          <span class="badge <%= @event.online? ? "text-bg-info" : "text-bg-secondary" %>"><%= @event.mode.to_s.capitalize %></span>
        </div>
        <h1 class="h2 mb-3"><%= @event.title %></h1>
        <h2 class="h5">About this event</h2>
        <p class="text-muted"><%= simple_format(@event.description) %></p>

        <% if !@event.online? && @event.venue.present? %>
          <% map_query = ERB::Util.url_encode(@event.venue) %>
          <h2 class="h5 mt-4">Location</h2>
          <div class="position-relative border rounded overflow-hidden" style="height: 260px;">
            <iframe src="https://www.google.com/maps?q=<%= map_query %>&output=embed"
                    title="Map of <%= @event.venue %>" width="100%" height="100%" style="border: 0;"
                    loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            <%# Transparent overlay so a click opens the full map in a new tab %>
            <%= link_to "", "https://www.google.com/maps/search/?api=1&query=#{map_query}",
                  target: "_blank", rel: "noopener", class: "position-absolute top-0 start-0 w-100 h-100",
                  aria: { label: "Open #{@event.venue} in Google Maps" } %>
          </div>
          <div class="small text-muted mt-1">Click the map to open it in Google Maps.</div>
        <% end %>
      </div>

      <div class="col-lg-4">
        <div class="border rounded p-3 bg-light">
          <dl class="mb-3">
            <dt class="small text-muted">Date &amp; time</dt>
            <dd><%= @event.starts_at&.strftime("%A, %d %B %Y") %><br><%= @event.starts_at&.strftime("%l:%M %p") %></dd>

            <dt class="small text-muted">Venue</dt>
            <dd><%= @event.venue %></dd>

            <% if @event.duration_text.present? %>
              <dt class="small text-muted">Duration</dt>
              <dd><%= @event.duration_text %></dd>
            <% end %>

            <dt class="small text-muted">Price</dt>
            <dd class="h4 mb-0"><%= @event.price.to_i.zero? ? "Free" : number_to_currency(@event.price, unit: "₹", precision: 0) %></dd>
          </dl>
          <%= link_to "Book now", new_event_booking_path(@event), class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>
