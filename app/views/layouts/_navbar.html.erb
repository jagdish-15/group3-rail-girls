<nav class="navbar navbar-expand bg-white border-bottom">
  <div class="container">
    <%= link_to "Eventapp", root_path, class: "navbar-brand fw-bold" %>
    <div class="navbar-nav ms-auto flex-row gap-3 align-items-center">
      <% if authenticated? %>
        <span class="text-muted small"><%= Current.user&.name %></span>
        <%= button_to "Log out", session_path, method: :delete, class: "btn btn-sm btn-outline-secondary" %>
      <% else %>
        <%= link_to "Log in", new_session_path, class: "nav-link" %>
        <%= link_to "Sign up", new_registration_path, class: "btn btn-sm btn-primary" %>
      <% end %>
    </div>
  </div>
</nav>
