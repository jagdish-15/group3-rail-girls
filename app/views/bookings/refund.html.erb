<% content_for :title, "Refund" %>

<div class="mx-auto" style="max-width: 520px;">
  <div class="card shadow-sm text-center">
    <div class="card-body p-4">
      <h1 class="h4 mb-1">Booking cancelled</h1>
      <p class="text-muted"><%= @booking.event.title %> &middot; Seats <%= @booking.seat_list.join(", ") %></p>

      <% if @booking.refund_amount.positive? %>
        <div class="display-6 my-3"><%= number_to_currency(@booking.refund_amount, unit: "₹", precision: 0) %></div>
        <p class="mb-1">Your refund has been initiated.</p>
        <p class="text-muted small">It will reach your original payment method in 5–7 business days.</p>
      <% else %>
        <p class="my-3">You hadn't paid for this booking, so there's nothing to refund.</p>
      <% end %>

      <p class="small fst-italic text-muted mt-3">
        Didn't receive your refund? No worries, just <strong>create a ticket at Zendesk</strong>.
        We hear they're great at closing them&hellip; eventually. 🎫
      </p>

      <%= link_to "My bookings", bookings_path, class: "btn btn-primary" %>
      <%= link_to "Browse events", events_path, class: "btn btn-link" %>
    </div>
  </div>
</div>
